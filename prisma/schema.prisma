generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  role                String    @default("USER")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  provider            String?
  tradingViewUsername String?
  accounts            Account[]
  sessions            Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ContentSection {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model GlossaryTerm {
  id        String   @id @default(cuid())
  romanized String
  japanese  String
  english   String
  isMain    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id         String   @id @default(cuid())
  question   String
  answer     String
  categories String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PricingTier {
  id           String           @id @default(cuid())
  name         String
  monthlyPrice String
  yearlyPrice  String
  tagline      String
  ctaText      String
  isFeatured   Boolean          @default(false)
  isTrial      Boolean          @default(false)
  order        Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  features     PricingFeature[]
}

model PricingFeature {
  id       String      @id @default(cuid())
  text     String
  included Boolean     @default(true)
  tierId   String
  tier     PricingTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  description String
  badge       String?
  category    String?
  href        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Stat {
  id        String   @id @default(cuid())
  label     String
  value     Float
  suffix    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
